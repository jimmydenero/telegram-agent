# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot (@userinfobot)
ALLOWED_TELEGRAM_USER_ID=
# Optional: chat id that POST /relay targets by default (usually same as your user id)
OWNER_CHAT_ID=
# Shared secret for the relay API: Authorization: Bearer <RELAY_SECRET>
RELAY_SECRET=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# Where the SQLite file lives (Render: /data on the persistent disk)
DATA_DIR=./data
PORT=3000
