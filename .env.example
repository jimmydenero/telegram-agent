# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot (@userinfobot)
ALLOWED_TELEGRAM_USER_ID=
# Optional: chat id that POST /relay targets by default (usually same as your user id)
OWNER_CHAT_ID=
# Shared secret for the relay API: Authorization: Bearer <RELAY_SECRET>
RELAY_SECRET=
# OpenRouter (https://openrouter.ai/keys). Without a key the bot answers "brain offline" to free text.
OPENROUTER_API_KEY=
# Any OpenRouter model id works here
OPENROUTER_MODEL=google/gemini-3.8-flash
# Sent as HTTP-Referer to OpenRouter (optional)
APP_URL=https://github.com/jimmydenero/telegram-agent
# Where the SQLite file lives (Render: /data on the persistent disk)
DATA_DIR=./data
PORT=3000
